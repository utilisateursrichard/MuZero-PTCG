{
  "model": {
    "num_card_ids": 1268,
    "card_embed_dim": 64,
    "latent_dim": 256,
    "num_heads": 8,
    "ff_dim": 512,
    "num_enc_layers": 4,
    "dropout_rate": 0.0,
    "max_actions": 128,
    "max_hand_size": 12,
    "max_bench_size": 5,
    "max_discard_size": 60,
    "max_prize_size": 6,
    "num_probe_tasks": 11,
    "num_deck_slots": 60,
    "num_value_bins": 51,
    "value_min": -1.2,
    "value_max": 1.2
  },
  "search": {
    "num_simulations": 25,
    "num_belief_samples": 4,
    "max_num_considered_actions": 8,
    "dirichlet_alpha": 0.3,
    "dirichlet_epsilon": 0.25,
    "temperature_init": 0.8,
    "temperature_min": 0.15,
    "temperature_decay": 0.85,
    "temperature_min_turn_estimate": true,
    "belief_from_known_deck": true
  },
  "train": {
    "num_unroll_steps": 5,
    "td_steps": 20,
    "gamma": 0.997,
    "target_network_tau": 0.995,
    "batch_size": 64,
    "learning_rate": 0.0003,
    "lr_warmup_steps": 2000,
    "weight_decay": 0.0001,
    "max_grad_norm": 1.0,
    "replay_buffer_size": 200000,
    "min_replay_size": 10000,
    "replay_alpha": 0.5,
    "replay_beta": 0.4,
    "plateau_window": 500,
    "plateau_threshold": 0.005,
    "num_total_steps": 500000,
    "self_play_interval": 100,
    "games_per_self_play": 8,
    "max_game_steps": 2000,
    "checkpoint_every": 1000,
    "buffer_push_every": 3000,
    "eval_every": 5000,
    "eval_games": 20,
    "reanalyze_num_simulations": 25,
    "priority_refresh_every": 500,
    "priority_refresh_fraction": 0.05,
    "priority_refresh_max_entries": 256,
    "priority_refresh_batch_size": 32,
    "value_loss_weight": 0.25,
    "reward_loss_weight": 1.0,
    "policy_loss_weight": 1.0,
    "policy_entropy_weight": 0.02,
    "probe_loss_weight": 0.05,
    "deck_loss_weight": 0.1,
    "consistency_loss_weight": 2.0,
    "hot_fix": false,
    "reset_policy_head": false,
    "reset_dynamics_head": false,
    "fresh_buffer": false,
    "freeze_representation_steps": 2000,
    "unfreeze_ramp_steps": 5000,
    "deck_builder_enabled": false,
    "deck_lr": 0.001,
    "deck_entropy_coef": 0.01,
    "deck_baseline_ema": 0.99
  },
  "hf": {
    "enabled": true,
    "repo_id": "richard151111/muzero-V2",
    "private": true,
    "token_env_var": "HF_TOKEN",
    "push_every_n_transitions": 10000,
    "local_dir": "./hf_checkpoints"
  },
  "wandb": {
    "enabled": true,
    "project": "muzero",
    "entity": null,
    "name": null,
    "mode": "online",
    "token_env_var": "WANDB_API_KEY",
    "kaggle_secret_name": "WANDB"
  },
  "infra": {
    "num_devices": 2,
    "seed": 42,
    "card_csv": "/kaggle/input/competitions/pokemon-tcg-ai-battle/EN_Card_Data.csv",
    "reference_deck_csv": "/kaggle/input/competitions/pokemon-tcg-ai-battle/sample_submission/sample_submission/deck.csv",
    "checkpoint_dir": "./checkpoints",
    "log_dir": "./logs",
    "debug_no_jit": false
  }
}